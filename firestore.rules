rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidExpense(data) {
      return data.amount is number && data.amount > 0
          && data.category is string && data.category.size() <= 64
          && data.date is timestamp
          && data.userId == request.auth.uid
          && (!('eventId' in data) || (data.eventId is string && data.eventId.size() <= 128));
    }

    function isValidEvent(data) {
      return data.name is string && data.name.size() <= 100
          && data.budget is number && data.budget >= 0
          && data.date is timestamp
          && data.userId == request.auth.uid;
    }

    function isValidBudget(data) {
      return data.limit is number && data.limit >= 0
          && data.category is string && data.category.size() <= 64
          && data.period is string && data.period.matches('^\\d{4}-\\d{2}$')
          && data.userId == request.auth.uid;
    }

    function isValidUser(data) {
      return data.userId == request.auth.uid
          && (data.get('currency', '$') is string && data.get('currency', '$').size() <= 5)
          && (data.get('email', '') is string && data.get('email', '').size() <= 256);
    }

    // --- Match Rules ---

    match /expenses/{expenseId} {
      allow create: if isSignedIn() && isValidExpense(incoming()) && isValidId(expenseId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidExpense(incoming()) 
          && incoming().diff(existing()).affectedKeys().hasOnly(['amount', 'category', 'date', 'description', 'eventId']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /budgets/{budgetId} {
      allow create: if isSignedIn() && isValidBudget(incoming()) && isValidId(budgetId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidBudget(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['limit']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /events/{eventId} {
      allow create: if isSignedIn() && isValidEvent(incoming()) && isValidId(eventId);
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidEvent(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'budget', 'date']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
    }
  }
}
